      "name": "1. GET 200 — немає в кеші (MISS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type: image/jpeg', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg');",
              "});",
              "",
              "pm.test('Картинка з http.cat (X-Cache: MISS)', () => {",
              "  pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
